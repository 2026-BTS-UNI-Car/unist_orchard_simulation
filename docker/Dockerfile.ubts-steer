# Steering SIM image (design 8.3 P5, docs/steering/GZ_MODEL_KO.md).
#
# Base: the local clean SIM image (ROS 2 Jazzy, Gazebo Harmonic gz-sim 8.15.0, DART 6.13.2,
# gz Python bindings, ros_gz_bridge, g++ 13.3, cmake 3.28, numpy, PyYAML, pytest, Embree
# raydeps). Pinned by tag and digest; on this PC the local RepoDigest equals the image ID.
# No apt and no pip: the base already has every package. The sources baked into the base that
# this branch replaces are deleted first, then the branch sources are copied, so files removed
# on the branch do not linger. A base without the old sources can be built from docker/Dockerfile.base and chosen
# with --build-arg UBTS_STEER_BASE=... (not built or verified yet: docs/provenance/BASE_IMAGE_KO.md; the default
# stays the local base, on which every result was verified). The image records the base, the source commit and the file
# hashes in /opt/ubts/STEER_IMAGE_MANIFEST.json. The steering firmware sources (firmware/ubts_steer_v3, P3) are
# copied too: the native lockstep program is built with them (firmware mode, R1); the build fails when they are
# missing from the image or not compiled in (UBTS_STEER_REQUIRE_FIRMWARE=1, the default; 0 allows an image without
# firmware mode, recorded in the manifest).
#
# Build from the work tree root (memory reservation first, see docs/steering/GZ_MODEL_KO.md):
#   docker build -f docker/Dockerfile.ubts-steer \
#     --build-arg BASE_IMAGE_ID=$(docker image inspect --format '{{.Id}}' <base tag>) \
#     --build-arg SOURCE_COMMIT=$(git rev-parse HEAD) \
#     --build-arg SOURCE_STATUS_SHA256=<sha256 of `git status --porcelain`> \
#     --build-arg IMAGE_TAG_HINT=ubts-steer-sim:wf6 -t ubts-steer-sim:wf6 .
# Images of this branch: ubts-steer-sim:p5 (phase 2, before the firmware was tracked), ubts-steer-sim:wf3 (phase 3,
# G-SIM update), ubts-steer-sim:p6a (phase 3, the headless stack of compose.ubts-steer.yaml: ESP emulator, sensor
# contract, supervisor, checks; docs/steering/P6A_HEADLESS_KO.md). WF-4: the row executor package tools/row_executor is
# copied to /opt/ubts/tools/row_executor (the executor container, steering.exec_container_main; it is on the PYTHONPATH of the
# executor service, docs/steering/S2_NODE_EXEC_KO.md) and is part of the manifest file list.
# ubts-steer-sim:wf4a / wf4b (2026-11-12): the first images with the executor package and the S2 format node; wf4b is
# the default of compose.ubts-steer.yaml until wf4c. ubts-steer-sim:wf4c (2026-11-12): with the row-following
# controller (closed_loop/steer_control.py), steering.exec_checks follow and steering.exec_run. ubts-steer-sim:wf5
# (2026-11-13): the final image of the steering SIM (one-press executor, the dashboard copy, the sidecar in the
# recorder role, profile=mapping LiDAR scans). ubts-steer-sim:wf6 (2026-11-13, stage 3): operator link timeout 1.0 s,
# start check 0.08 m/s, the IMU game rotation vector, the dashboard copy a92cfec; the default now.
# Dashboard (2026-11-13, D-13, docs/steering/SIM_DASHBOARD_KO.md): dashboard/config, dashboard_server and static are the
# dashboard repository's files at the commit of dashboard/DASHBOARD_SOURCE.json (tools/steer_sim/sync_dashboard.py);
# the build checks every file against that manifest. dashboard_sim/ (the simulation's provider, extension routes and
# extra static folder) is copied to /opt/ubts/dashboard_sim. The dashboard's native raster kernel moved to
# dashboard_server/native_raster.cc in that repository. dashboard/scripts stays the simulation's own copy (sensor
# bridges, recorder, steering host code).
ARG UBTS_STEER_BASE=ubts-sim-clean-tenth:20261008-1791399576735742400-14657b29@sha256:6209168a3507cf7a657464af99711e0cdf45329617e67bdafca87007367688b0
FROM ${UBTS_STEER_BASE}
ARG UBTS_STEER_BASE
ARG BASE_IMAGE_ID=unknown
ARG SOURCE_COMMIT=unknown
ARG SOURCE_STATUS_SHA256=unknown
ARG UBTS_STEER_REQUIRE_FIRMWARE=1
ARG IMAGE_TAG_HINT=ubts-steer-sim:wf6
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
WORKDIR /opt/ubts
RUN rm -rf /opt/ubts/dashboard /opt/ubts/dashboard_sim /opt/ubts/sim/ubts /opt/ubts/ros2_ws/src/orchard_gazebo \
           /opt/ubts/ros2_ws/src/orchard_navigation /opt/ubts/firmware /opt/ubts/tools/row_executor \
 && rm -f /opt/ubts/compose.ubts*.yaml
COPY dashboard /opt/ubts/dashboard
COPY dashboard_sim /opt/ubts/dashboard_sim
COPY sim/ubts /opt/ubts/sim/ubts
COPY ros2_ws/src/orchard_gazebo /opt/ubts/ros2_ws/src/orchard_gazebo
COPY ros2_ws/src/orchard_navigation /opt/ubts/ros2_ws/src/orchard_navigation
COPY compose.ubts*.yaml /opt/ubts/
COPY firmware /opt/ubts/firmware
COPY tools/row_executor /opt/ubts/tools/row_executor
ENV PYTHONPATH=/opt/ubts/raydeps:/opt/ubts/dashboard:/opt/ubts/sim/ubts \
    PYTHONDONTWRITEBYTECODE=1 \
    UBTS_STEER_BUILD_DIR=/opt/ubts/steer_native_build \
    MPLBACKEND=Agg
# The native raster kernel of the dashboard (same step as docker/Dockerfile.ubts; the base copy went with the old
# sources) and the steering native lockstep program (decision R1 (d)) are built with the image's g++.
RUN g++ -O3 -std=c++17 -shared -fPIC /opt/ubts/dashboard/dashboard_server/native_raster.cc \
      -o /opt/ubts/dashboard/dashboard_server/_native_raster.so \
 && mkdir -p /opt/ubts/steer_native_build /runtime /run/ubts-steer \
 && (python3 -B /opt/ubts/sim/ubts/steering/native/build.py --json > /opt/ubts/steer_native_build/BUILD_RESULT.json \
       2> /opt/ubts/steer_native_build/BUILD_STDERR.txt \
     || echo '{"built": false, "note": "native build failed at image build time; see BUILD_STDERR.txt"}' \
          > /opt/ubts/steer_native_build/BUILD_RESULT.json) \
 && python3 -B -c "import json, sys; r = json.load(open('/opt/ubts/steer_native_build/BUILD_RESULT.json')); \
fw = r.get('firmware_build_id'); print('steering native build: binary %s, firmware_build_id %s' % (r.get('path'), fw)); \
sys.exit(0 if (fw or '${UBTS_STEER_REQUIRE_FIRMWARE}' == '0') else 'firmware_build_id missing in BUILD_RESULT.json: the native build failed or ran without firmware/ubts_steer_v3 (see BUILD_STDERR.txt)')"
RUN python3 -B -c "import hashlib, json, os, time; \
roots = ('dashboard', 'dashboard_sim', 'sim/ubts', 'ros2_ws/src/orchard_gazebo', 'ros2_ws/src/orchard_navigation', \
         'tools/row_executor', \
         'firmware'); \
files = sorted(os.path.join(d, n) for r in roots for d, _, ns in os.walk(r) for n in ns); \
files += sorted(n for n in os.listdir('.') if n.startswith('compose.ubts') and n.endswith('.yaml')); \
digest = lambda p: hashlib.sha256(open(p, 'rb').read()).hexdigest(); \
rows = {p: digest(p) for p in files if not p.endswith(('.so', '.pyc')) and '/steer_native_build/' not in p}; \
combined = hashlib.sha256(''.join('%s %s\n' % (v, k) for k, v in sorted(rows.items())).encode()).hexdigest(); \
native = json.load(open('/opt/ubts/steer_native_build/BUILD_RESULT.json')); \
manifest = dict(schema='ubts.steer_image_manifest.v1', image_tag_hint='${IMAGE_TAG_HINT}', \
  base_image_ref='${UBTS_STEER_BASE}', base_image_id='${BASE_IMAGE_ID}', source_commit='${SOURCE_COMMIT}', \
  source_status_sha256='${SOURCE_STATUS_SHA256}', built_utc=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()), \
  source_file_count=len(rows), source_files_sha256=combined, native_build=native, files=rows, \
  firmware_required='${UBTS_STEER_REQUIRE_FIRMWARE}' != '0', firmware_build_id=native.get('firmware_build_id'), \
  note='placeholder-based SIM image; no apt or pip; sources copied from the steering branch work tree'); \
open('/opt/ubts/STEER_IMAGE_MANIFEST.json', 'w').write(json.dumps(manifest, indent=1, sort_keys=True) + '\n')" \
 && python3 -B -c "import hashlib, json, os; d = '/opt/ubts/dashboard'; \
m = json.load(open(os.path.join(d, 'DASHBOARD_SOURCE.json'))); \
bad = [p for p, r in m['files'].items() if hashlib.sha256(open(os.path.join(d, p), 'rb').read()).hexdigest() != r['sha256']]; \
extra = sorted(os.path.relpath(os.path.join(w, n), d).replace(os.sep, '/') for root in m['roots'] \
               for w, ds, ns in os.walk(os.path.join(d, root)) for n in ns if not n.endswith(('.so', '.pyc'))); \
extra = [p for p in extra if p not in m['files']]; \
assert not bad and not extra, ('dashboard copy differs from DASHBOARD_SOURCE.json', bad[:5], extra[:5]); \
print('dashboard copy: commit %s, %d files' % (m['commit'][:12], len(m['files'])))" \
 && DASHBOARD_MODE=simulation DASHBOARD_VEHICLE=front_steer \
    DASHBOARD_PROVIDER=ubts_sim_dashboard.provider:SimulationProvider DASHBOARD_EXTENSION=ubts_sim_dashboard.extension \
    DASHBOARD_EXTRA_STATIC=/opt/ubts/dashboard_sim/static PYTHONPATH=$PYTHONPATH:/opt/ubts/dashboard_sim \
    python3 -B -c "from dashboard_server import app, extensions; s = extensions.DashboardSettings.from_env(); \
import ubts_sim_dashboard.provider, ubts_sim_dashboard.extension as e; assert s.simulation and len(extensions.routes_of(e)) == 1" \
 && source /opt/ros/jazzy/setup.bash \
 && python3 -B -c "import numpy, yaml, PIL, matplotlib; import gz.sim8, gz.transport13, gz.msgs10; from steering import gz_model, gz_assemble, gz_probe, gz_direct_drive" \
 && python3 -B -c "import rclpy, adapter; from steering import gz_esp_emulator, supervisor_steer, sensor_contract_steer, verify_steer, p6a_checks, p6a_graph, p6a_client, p6a_imu_model; sensor_contract_steer.make_node_class()" \
 && PYTHONPATH=$PYTHONPATH:/opt/ubts/tools python3 -B -c "import rclpy; from steering import s2_format_node, exec_container_main, exec_checks; from row_executor import executor_main, operator_http, bridge_client; executor_main.verify_sources(); executor_main.verify_vendor()"
CMD ["python3", "-B", "-m", "steering.gz_probe", "--help"]
