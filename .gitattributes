* text=auto eol=lf
*.sh text eol=lf
*.png binary
*.jpg binary
*.gif binary
*.mp4 binary
*.webp binary
*.ico binary
*.woff2 binary
*.npz binary
# Third-party web libraries of the dashboard copy: bytes as published (see also dashboard/.gitattributes).
dashboard/static/vendor/** -text -whitespace
# dashboard/config, dashboard_server and static are the dashboard repository's blobs, unchanged
# (tools/steer_sim/sync_dashboard.py); none of them has CRLF, so the rules above keep them byte-exact.
# Hash-checked files of the row executor (SHA256SUMS, vendored copies): always LF.
tools/row_executor/SHA256SUMS text eol=lf
tools/row_executor/vendor/** text eol=lf
