<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation participants share /dev/shm. One 640x360 RGB frame exceeds
     Fast DDS's default 512 KiB segment; reserve room for full frame fragments.
     RViz joins sim IPC. Other GUI clients keep the UDP-only fallback profile. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>ubts_sim_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>ubts_sim_udp</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>4194304</sendBufferSize>
      <receiveBufferSize>4194304</receiveBufferSize>
      <interfaceWhiteList>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="ubts_sim" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>ubts_sim_shm</transport_id>
        <transport_id>ubts_sim_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
