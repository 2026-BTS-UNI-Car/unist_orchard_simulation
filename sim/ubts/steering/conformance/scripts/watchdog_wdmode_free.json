{
  "schema": "ubts.steer_conformance.v1",
  "name": "watchdog_wdmode_free",
  "spec": ["6.2", "6.4"],
  "description": "wdmode 2(free): watchdog(틱 521)에 조향은 바로 OFF(EN 0), 구동 brake, DISARMED, W 521.",
  "setup": {"boot_seed": 1, "chip_id": "5A1B2C", "eeprom": {"record": {"cal_id": 7, "raw_l": 842, "raw_c": 512, "raw_r": 181, "soft_l": 935, "soft_r": -935, "pol_ok": 1, "mdir": 1, "params": {"wdmode": 2, "ttlmax": 1000}}}, "adc": {"mode": "script", "raw": 512}},
  "inputs": [
    {"tick": 10, "text": "ARM {boot}*{crc}\n"},
    {"tick": 20, "text": "C 1 1000 100 100 0*{crc}\n"}
  ],
  "expect": [
    {"type": "line", "tick": 0, "text": "UBTS_STEER_V3 hello proto=3 build={any} dev=5A1B2C boot={boot} rst=power_on hw=front_steer_v0 out=drive2,steer1 cal=7 sim=1 wd=500 ttl=1000 st=20 drop=0*{crc}"},
    {"type": "line", "tick": 0, "text": "UBTS_STEER_V3 cal id=7 crc=84FD85A1 left=842 center=512 right=181 soft=935,-935 pol=ok mdir=1 caldirty=0 cfgdirty=0*{crc}"},
    {"type": "pins", "tick": 520, "steer_en": 1, "drive_l": 100},
    {"type": "line", "tick": 521, "text": "W 521*{crc}"},
    {"type": "pins", "tick": 521, "steer_en": 0, "steer_pwm": 0, "drive_l": 0, "mcu_state": 1},
    {"type": "change", "channel": "steer_en", "tick": 521, "to": 0},
    {"type": "status", "tick": 550, "fields": {"st": 1, "en": 1, "fl": "1000"}},
    {"type": "no_line", "window": [0, 600], "kinds": ["N", "F", "A", "P"]}
  ],
  "end": {"tick": 600}
}
